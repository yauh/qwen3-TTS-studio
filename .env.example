# ============================================================
# LLM Provider Configuration
# ============================================================
# Choose your LLM provider: 'openai' or 'portkey'
# Default: openai
LLM_PROVIDER=openai

# Optional: Override the default model (default: gpt-5.2)
# Supported models:
# - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
# - With Portkey: gemini-1.5-pro, claude-3-opus, etc. (any Portkey-supported model)
# LLM_MODEL=gpt-5.2

# ============================================================
# OpenAI Configuration
# ============================================================
# Required when LLM_PROVIDER=openai (default)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ============================================================
# Portkey Configuration
# ============================================================
# Required when LLM_PROVIDER=portkey
# Portkey provides observability, caching, and fallback capabilities
# for your LLM calls while maintaining OpenAI compatibility

# Portkey API Key (Required)
# Get your API key from: https://app.portkey.ai/
# PORTKEY_API_KEY=sk-portkey-...

# Option 1: Use Portkey Virtual Key (Recommended)
# Create a virtual key in Portkey dashboard that points to your OpenAI account
# This allows Portkey to proxy requests to OpenAI with added observability
# PORTKEY_VIRTUAL_KEY=openai-virtual-...

# Option 2: Use OpenAI API Key directly (if no virtual key)
# If PORTKEY_VIRTUAL_KEY is not set, the system will use OPENAI_API_KEY
# with Portkey as a proxy for observability
# OPENAI_API_KEY=sk-proj-...

# Optional: Custom Portkey base URL (default: https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# ============================================================
# Setup Instructions
# ============================================================

# For OpenAI (default):
# 1. Copy this file to .env
# 2. Set LLM_PROVIDER=openai (or leave as default)
# 3. Add your OpenAI API key to OPENAI_API_KEY
# 4. Run the application

# For Portkey (Option 1 - Virtual Key):
# 1. Copy this file to .env
# 2. Set LLM_PROVIDER=portkey
# 3. Sign up at https://app.portkey.ai/
# 4. Create a virtual key for OpenAI in the Portkey dashboard
# 5. Add your Portkey API key to PORTKEY_API_KEY
# 6. Add your Portkey virtual key to PORTKEY_VIRTUAL_KEY
# 7. Run the application

# For Portkey (Option 2 - Direct OpenAI Key):
# 1. Copy this file to .env
# 2. Set LLM_PROVIDER=portkey
# 3. Sign up at https://app.portkey.ai/
# 4. Add your Portkey API key to PORTKEY_API_KEY
# 5. Add your OpenAI API key to OPENAI_API_KEY
# 6. Run the application (no virtual key needed)

# ============================================================
# Benefits of Using Portkey
# ============================================================
# - Observability: Track all LLM requests, tokens, latency, and costs
# - Caching: Reduce costs and latency with semantic caching
# - Fallbacks: Automatic fallback to alternative providers
# - Load Balancing: Distribute requests across multiple providers
# - Rate Limiting: Control request rates and costs
# - Prompt Management: Version and manage prompts centrally
# - Analytics: Detailed analytics on LLM usage and performance

# ============================================================
# Example Configurations
# ============================================================

# Example 1: Using OpenAI directly
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-abc123...

# Example 2: Using Portkey with virtual key
# LLM_PROVIDER=portkey
# PORTKEY_API_KEY=sk-portkey-xyz789...
# PORTKEY_VIRTUAL_KEY=openai-virtual-def456...

# Example 3: Using Portkey with direct OpenAI key
# LLM_PROVIDER=portkey
# PORTKEY_API_KEY=sk-portkey-xyz789...
# OPENAI_API_KEY=sk-proj-abc123...

# Example 4: Using Portkey with Gemini (or other models)
# LLM_PROVIDER=portkey
# LLM_MODEL=gemini-1.5-pro
# PORTKEY_API_KEY=sk-portkey-xyz789...
# PORTKEY_VIRTUAL_KEY=gemini-virtual-def456...

# Example 5: Using Portkey with Claude
# LLM_PROVIDER=portkey
# LLM_MODEL=claude-3-5-sonnet-20241022
# PORTKEY_API_KEY=sk-portkey-xyz789...
# PORTKEY_VIRTUAL_KEY=claude-virtual-ghi789...

# Example 6: Using a different OpenAI model
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo
# OPENAI_API_KEY=sk-proj-abc123...
