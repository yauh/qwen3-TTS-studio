# ============================================================
# LLM Provider Configuration
# ============================================================
# Choose your LLM provider: 'openai', 'portkey', or 'localllm'
# Default: openai
LLM_PROVIDER=openai

# Optional: Override the default model (default: gpt-5.2)
# Supported models:
# - OpenAI: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.
# - Portkey: gemini-1.5-pro, claude-3-5-sonnet, etc. (any Portkey-supported model)
# - Local LLM: llama3.2:3b, qwen2.5:3b, mistral:7b, etc. (any Ollama/LM Studio model)
# LLM_MODEL=gpt-5.2

# ============================================================
# OpenAI Configuration
# ============================================================
# Required when LLM_PROVIDER=openai (default)
# Also required for Whisper audio transcription (used in Voice Clone feature)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ============================================================
# Portkey Configuration
# ============================================================
# Required when LLM_PROVIDER=portkey
# Portkey provides observability, caching, and fallback capabilities
# for your LLM calls while maintaining OpenAI compatibility

# Portkey API Key (Required)
# Get your API key from: https://app.portkey.ai/
# Configure your provider credentials (OpenAI, Gemini, Claude, etc.) in Portkey dashboard
# PORTKEY_API_KEY=sk-portkey-...

# Optional: Custom Portkey base URL (default: https://api.portkey.ai/v1)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# ============================================================
# Local LLM Configuration (Ollama / LM Studio)
# ============================================================
# Required when LLM_PROVIDER=localllm
# Runs LLMs locally without API costs

# Optional: Local LLM base URL
# For Ollama (default): http://localhost:11434/v1
# For LM Studio: http://localhost:1234/v1
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1

# ============================================================
# Setup Instructions
# ============================================================

# For OpenAI (default):
# 1. Copy this file to .env
# 2. Set LLM_PROVIDER=openai (or leave as default)
# 3. Add your OpenAI API key to OPENAI_API_KEY
# 4. Run the application

# For Portkey:
# 1. Copy this file to .env
# 2. Sign up at https://app.portkey.ai/
# 3. Configure your provider credentials in Portkey dashboard (OpenAI, Gemini, Claude, etc.)
# 4. Set LLM_PROVIDER=portkey
# 5. Add your Portkey API key to PORTKEY_API_KEY
# 6. Set LLM_MODEL to your desired model (e.g., gemini-1.5-pro, gpt-4, claude-3-5-sonnet)
# 7. Run the application

# For Local LLM (Ollama):
# 1. Install Ollama from https://ollama.ai/
# 2. Pull a model: ollama pull llama3.2:3b
# 3. Copy this file to .env
# 4. Set LLM_PROVIDER=localllm
# 5. Set LLM_MODEL to your model (e.g., llama3.2:3b, qwen2.5:3b, mistral:7b)
# 6. Run the application (Ollama server starts automatically)

# For Local LLM (LM Studio):
# 1. Install LM Studio from https://lmstudio.ai/
# 2. Download and load a model in LM Studio
# 3. Start the local server in LM Studio (default port 1234)
# 4. Copy this file to .env
# 5. Set LLM_PROVIDER=localllm
# 6. Set LLM_MODEL to the model identifier
# 7. Set LLM_LOCAL_BASE_URL=http://localhost:1234/v1
# 8. Run the application

# ============================================================
# Benefits of Using Portkey
# ============================================================
# - Observability: Track all LLM requests, tokens, latency, and costs
# - Caching: Reduce costs and latency with semantic caching
# - Fallbacks: Automatic fallback to alternative providers
# - Load Balancing: Distribute requests across multiple providers
# - Rate Limiting: Control request rates and costs
# - Prompt Management: Version and manage prompts centrally
# - Analytics: Detailed analytics on LLM usage and performance

# ============================================================
# Example Configurations
# ============================================================

# Example 1: Using OpenAI directly
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-abc123...

# Example 2: Using Portkey with Gemini
# LLM_PROVIDER=portkey
# LLM_MODEL=gemini-1.5-pro
# PORTKEY_API_KEY=sk-portkey-xyz789...

# Example 3: Using Portkey with Claude
# LLM_PROVIDER=portkey
# LLM_MODEL=claude-3-5-sonnet-20241022
# PORTKEY_API_KEY=sk-portkey-xyz789...

# Example 4: Using Portkey with GPT-4
# LLM_PROVIDER=portkey
# LLM_MODEL=gpt-4-turbo
# PORTKEY_API_KEY=sk-portkey-xyz789...

# Example 5: Using local LLM with Ollama
# LLM_PROVIDER=localllm
# LLM_MODEL=llama3.2:3b

# Example 6: Using local LLM with LM Studio
# LLM_PROVIDER=localllm
# LLM_MODEL=qwen2.5-3b-instruct
# LLM_LOCAL_BASE_URL=http://localhost:1234/v1

# Example 7: Using a different OpenAI model (direct)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo
# OPENAI_API_KEY=sk-proj-abc123...
